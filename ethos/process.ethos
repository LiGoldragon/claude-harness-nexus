Process
[ claude_harness:signal:[ Report Subscribe Reported Subscribed Changed ]
  claude_harness:meta:[ Configure Configured ]
  claude_harness:memory:[ Watch ]
  claude_harness:[ Observe Recall Configure RowCount ]
  claude_harness:emission:[ Follow ] ]
[ Report.{ []
           [ Reported Watch Observe Changed ]
           Reporting }
  Watch.{ [ RowCount ]
          [ Follow Observe Changed ]
          Watching }
  Subscribe.{ []
              [ Recall Subscribed ] }
  Configure.{ []
              [ Configure Configured ]
              Configuring } ]
[ Reporting.[ Observed Unremembered ]
  Watching.[ Forgotten Unfollowed ]
  Configuring.[ Configured Unremembered ] ]
